# Copia a .env (o exporta en tu shell). Nunca subas tus claves al repositorio.
ANTHROPIC_API_KEY=
PAISAJIA_GENERATOR=mock          # mock | flux | sd
PAISAJIA_LLM=auto                # auto | claude | ollama | simulado
PAISAJIA_LLM_MODEL=claude-opus-5-5
PAISAJIA_OLLAMA_MODEL=qwen2.5:3b # modelo local de Ollama (ollama pull qwen2.5:3b)
# OLLAMA_HOST=http://localhost:11434
# PAISAJIA_OLLAMA_NUM_GPU=0      # 0 = Qwen solo en CPU (deja la GPU a FLUX)
# PAISAJIA_GEN_SIZE=1024         # resolución de generación de FLUX (768 en una T4)
# PAISAJIA_DTYPE=auto            # auto | bf16 | fp16  (auto: fp16 en T4, bf16 en A100/A6000)
# PAISAJIA_TE_QUANT=auto       # auto | 4bit | 8bit | off  (auto: 4 bits en GPUs < 20 GB, p. ej. T4)
# PAISAJIA_APP_PASSWORD=         # protege la interfaz con contraseña (usuario: paisajia)
PAISAJIA_VISION=auto             # auto | off  (off = métricas proxy, sin descargar DINOv2/CLIP/LPIPS)
PAISAJIA_DEVICE=auto             # auto | cuda | cpu
# HF_TOKEN=                      # si el modelo de Hugging Face requiere aceptar la licencia
